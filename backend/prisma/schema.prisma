// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  isVerified   Boolean  @default(false)
  isSuspended  Boolean  @default(false)
  fcmToken     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ads                     Ad[]
  payments                Payment[]
  customerConversations   Conversation[] @relation("CustomerConversations")
  advertiserConversations Conversation[] @relation("AdvertiserConversations")
  sentMessages            Message[]
  reviewsGiven            Review[]       @relation("CustomerReviews")
  reviewsReceived         Review[]       @relation("AdvertiserReviews")
  reportsFiled            Report[]
  adImpressions           AdImpression[]
  adVisits                AdVisit[]
  adConversions           AdConversion[]
  auditEntries            AdminAuditLog[] @relation("AuditActor")

  @@map("users")
}

enum Sector {
  LAND
  HOUSE_RENT
}

enum AdStatus {
  PENDING
  LIVE
  REJECTED
  SOLD
  REMOVED
}

model Ad {
  id               String   @id @default(cuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id])
  sector           Sector
  title            String
  description      String
  price            Decimal  @db.Decimal(12, 2)
  locationDivision String?
  locationArea     String
  locationDistrict String
  address          String?
  latitude         Float?
  longitude        Float?
  attributes       Json?
  photos           String[]
  status           AdStatus @default(PENDING)
  rejectionReason  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payments      Payment[]
  boosts        Boost[]
  conversations Conversation[]
  reports       Report[]
  impressions   AdImpression[]
  visits        AdVisit[]
  conversions   AdConversion[]

  @@map("ads")
}

enum BoostTier {
  THREE_DAY
  SEVEN_DAY
  FIFTEEN_DAY
}

enum BoostStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentGateway {
  BKASH
  NAGAD
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  adId       String
  ad         Ad             @relation(fields: [adId], references: [id])
  gateway    PaymentGateway
  gatewayRef String?        @unique
  amount     Decimal        @db.Decimal(12, 2)
  status     PaymentStatus  @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  boost Boost?

  @@map("payments")
}

// Partial unique index on (adId) WHERE status IN (PENDING, ACTIVE) exists
// in the database (see migrations/); not representable in this DSL.
model Boost {
  id        String      @id @default(cuid())
  adId      String
  ad        Ad          @relation(fields: [adId], references: [id])
  tier      BoostTier
  startAt   DateTime?
  endAt     DateTime?
  paymentId String      @unique
  payment   Payment     @relation(fields: [paymentId], references: [id])
  status    BoostStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("boosts")
}

model Conversation {
  id           String   @id @default(cuid())
  adId         String
  ad           Ad       @relation(fields: [adId], references: [id])
  customerId   String
  customer     User     @relation("CustomerConversations", fields: [customerId], references: [id])
  advertiserId String
  advertiser   User     @relation("AdvertiserConversations", fields: [advertiserId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages Message[]

  @@unique([adId, customerId, advertiserId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@map("messages")
}

model Review {
  id           String   @id @default(cuid())
  advertiserId String
  advertiser   User     @relation("AdvertiserReviews", fields: [advertiserId], references: [id])
  customerId   String
  customer     User     @relation("CustomerReviews", fields: [customerId], references: [id])
  rating       Int
  comment      String?
  // Moderation is a soft hide, not a delete: the rating stays out of the
  // advertiser's public average but the record survives for dispute handling.
  isHidden     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([advertiserId, customerId])
  @@index([isHidden])
  @@map("reviews")
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  adId       String
  ad         Ad           @relation(fields: [adId], references: [id])
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id])
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@map("reports")
}

enum ImpressionContext {
  SEARCH
  SECTOR_LISTING
  HOMEPAGE
}

model AdImpression {
  id        String            @id @default(cuid())
  adId      String
  ad        Ad                @relation(fields: [adId], references: [id])
  viewerId  String?
  viewer    User?             @relation(fields: [viewerId], references: [id])
  context   ImpressionContext
  createdAt DateTime          @default(now())

  @@map("ad_impressions")
}

model AdVisit {
  id        String   @id @default(cuid())
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id])
  viewerId  String?
  viewer    User?    @relation(fields: [viewerId], references: [id])
  sessionId String
  createdAt DateTime @default(now())

  conversion AdConversion?

  @@map("ad_visits")
}

model AdConversion {
  id          String   @id @default(cuid())
  adId        String
  ad          Ad       @relation(fields: [adId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  visitId     String?  @unique
  visit       AdVisit? @relation(fields: [visitId], references: [id])
  convertedAt DateTime @default(now())

  @@map("ad_conversions")
}

enum AuditAction {
  AD_APPROVE
  AD_REJECT
  AD_REMOVE
  AD_EDIT
  AD_DELETE
  REPORT_RESOLVE
  REPORT_DELETE
  USER_EDIT
  USER_DELETE
  REVIEW_DELETE
  USER_SUSPEND
  USER_UNSUSPEND
  USER_GRANT_ADMIN
  USER_REVOKE_ADMIN
  BOOST_CANCEL
  BOOST_EXTEND
  PAYMENT_MARK_FAILED
  PAYMENT_MARK_PAID
  PAYMENT_GATEWAY_RECHECK
  REVIEW_HIDE
  REVIEW_UNHIDE
}

enum AuditTargetType {
  AD
  USER
  REPORT
  BOOST
  PAYMENT
  REVIEW
}

/**
 * Append-only record of every state change an admin made. Nothing in the app
 * updates or deletes a row here — a console that can suspend accounts and take
 * listings down has to be able to answer "who did this, and when".
 */
model AdminAuditLog {
  id         String          @id @default(cuid())
  actorId    String
  actor      User            @relation("AuditActor", fields: [actorId], references: [id])
  action     AuditAction
  targetType AuditTargetType
  targetId   String
  /** Human-readable one-liner, rendered as-is in the audit table. */
  summary    String
  /** Action-specific detail: reason codes, before/after values, bulk batch id. */
  metadata   Json?
  createdAt  DateTime        @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}
