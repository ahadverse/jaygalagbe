// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  isAdvertiser Boolean  @default(false)
  isAdmin      Boolean  @default(false)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ads                     Ad[]
  payments                Payment[]
  customerConversations   Conversation[] @relation("CustomerConversations")
  advertiserConversations Conversation[] @relation("AdvertiserConversations")
  sentMessages            Message[]
  reviewsGiven            Review[]       @relation("CustomerReviews")
  reviewsReceived         Review[]       @relation("AdvertiserReviews")
  reportsFiled            Report[]

  @@map("users")
}

enum Sector {
  LAND
  HOUSE_RENT
}

enum AdStatus {
  PENDING
  LIVE
  REJECTED
  SOLD
  REMOVED
}

model Ad {
  id               String   @id @default(cuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id])
  sector           Sector
  title            String
  description      String
  price            Decimal  @db.Decimal(12, 2)
  locationArea     String
  locationDistrict String
  address          String?
  latitude         Float?
  longitude        Float?
  attributes       Json?
  photos           String[]
  status           AdStatus @default(PENDING)
  rejectionReason  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payments      Payment[]
  boosts        Boost[]
  conversations Conversation[]
  reports       Report[]

  @@map("ads")
}

enum BoostTier {
  THREE_DAY
  SEVEN_DAY
  FIFTEEN_DAY
}

enum BoostStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentGateway {
  BKASH
  NAGAD
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  adId       String
  ad         Ad             @relation(fields: [adId], references: [id])
  gateway    PaymentGateway
  gatewayRef String?        @unique
  amount     Decimal        @db.Decimal(12, 2)
  status     PaymentStatus  @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  boost Boost?

  @@map("payments")
}

model Boost {
  id        String      @id @default(cuid())
  adId      String
  ad        Ad          @relation(fields: [adId], references: [id])
  tier      BoostTier
  startAt   DateTime?
  endAt     DateTime?
  paymentId String      @unique
  payment   Payment     @relation(fields: [paymentId], references: [id])
  status    BoostStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("boosts")
}

model Conversation {
  id           String   @id @default(cuid())
  adId         String
  ad           Ad       @relation(fields: [adId], references: [id])
  customerId   String
  customer     User     @relation("CustomerConversations", fields: [customerId], references: [id])
  advertiserId String
  advertiser   User     @relation("AdvertiserConversations", fields: [advertiserId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages Message[]

  @@unique([adId, customerId, advertiserId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@map("messages")
}

model Review {
  id           String   @id @default(cuid())
  advertiserId String
  advertiser   User     @relation("AdvertiserReviews", fields: [advertiserId], references: [id])
  customerId   String
  customer     User     @relation("CustomerReviews", fields: [customerId], references: [id])
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([advertiserId, customerId])
  @@map("reviews")
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  adId       String
  ad         Ad           @relation(fields: [adId], references: [id])
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id])
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@map("reports")
}
